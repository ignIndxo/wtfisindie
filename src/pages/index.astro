---
import Layout from "../layouts/Layout.astro";
---

<Layout title="WTF is Indie? | Coming Soon" description="WTF is Indie? Coming soon. Get tickets on Fatsoma.">
  <main class="flex min-h-screen flex-col bg-black font-display text-white italic items-center justify-center gap-6 p-4 text-center">
    <h1 class="text-[clamp(2.5rem,12vw,8rem)] leading-[1.1] font-normal">COMING SOON...</h1>
    <a
      class="text-[clamp(1.5rem,5vw,2.5rem)] underline underline-offset-[0.2em] hover:opacity-70 focus-visible:opacity-70"
      href="https://www.fatsoma.com/p/wtfisindie"
      target="_blank"
      rel="noopener noreferrer"
    >
      get tickets here
    </a>
  </main>
</Layout>
