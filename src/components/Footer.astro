---
import { site } from "../config/site";
import Logo from "./Logo.astro";
---

<footer id="contact">
  <div class="footer-bottom">
    <Logo />
    <div>
      <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">INSTAGRAM ↗</a>
      <a href="#zine">THE ZINE ↗</a>
      <a href={site.fatsomaUrl} target="_blank" rel="noopener noreferrer">TICKETS ↗</a>
      <a
        class="contact-link"
        href={site.instagramUrl}
        data-contact={site.contactEncoded}
        target="_blank"
        rel="noopener noreferrer">CONTACT ↗</a
      >
    </div>
  </div>
</footer>

<script>
  // The address is only assembled on interaction, so scrapers reading the HTML
  // never see it. Without JavaScript the link falls back to Instagram.
  const link = document.querySelector<HTMLAnchorElement>(".contact-link");
  const arm = () => {
    const encoded = link?.dataset.contact;
    if (!link || !encoded) return;
    link.href = `mailto:${atob(encoded)}`;
    link.removeAttribute("target");
    link.removeAttribute("rel");
  };
  for (const type of ["pointerenter", "focus", "touchstart"]) {
    link?.addEventListener(type, arm, { once: true, passive: true });
  }
</script>

<style>
  footer {
    background: var(--black);
    color: #f8f4eb;
  }

  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    padding: 3rem 6vw 2.5rem;
  }

  .footer-bottom div {
    display: flex;
    gap: 1.5rem;
  }

  .footer-bottom div a {
    font: 0.58rem/1.7 var(--font-mono);
  }

  @media (max-width: 600px) {
    .footer-bottom {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom div {
      flex-wrap: wrap;
    }
  }
</style>
